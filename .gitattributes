# Akhir baris: teks disimpan dan diambil dengan LF di semua platform.
* text=auto eol=lf

# Skrip Windows memerlukan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Berkas biner.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.zip binary
*.raw binary
*.pt binary
*.npz binary
*.npy binary
