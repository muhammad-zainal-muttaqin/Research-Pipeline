<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.2-c001 63.139439, 2010/09/27-13:37:26        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmp:CreateDate>2023-04-21T15:15:35+05:30</xmp:CreateDate>
         <xmp:CreatorTool>Springer</xmp:CreatorTool>
         <xmp:ModifyDate>2023-04-21T15:33:31+05:30</xmp:ModifyDate>
         <xmp:MetadataDate>2023-04-21T15:33:31+05:30</xmp:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Acrobat Distiller 10.1.8 (Windows)</pdf:Producer>
         <pdf:Keywords>Emotion; Machine learning; Twitter; Long COVID</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>doi:10.1007/978-981-19-8406-8_42</dc:identifier>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>Springer Nature Singapore</rdf:li>
            </rdf:Bag>
         </dc:publisher>
