<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 4.0-c316 44.253921, Sun Oct 01 2006 17:14:39">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>doi:10.1016/j.agrcom.2026.100125</dc:identifier>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Comprehensive performance evaluation of YOLOv12, YOLO11, YOLOv10, YOLOv9 and YOLOv8 on detecting and counting fruitlet in complex orchard environments</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Ranjan Sapkota</rdf:li>
               <rdf:li>Zhichao Meng</rdf:li>
               <rdf:li>Martin Churuvija</rdf:li>
               <rdf:li>Xiaoqiang Du</rdf:li>
               <rdf:li>Zenghong Ma</rdf:li>
               <rdf:li>Manoj Karkee</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>You Only Look Once (YOLO)</rdf:li>
               <rdf:li>YOLO comparison</rdf:li>
               <rdf:li>Object detection</rdf:li>
               <rdf:li>Fruitlet detection</rdf:li>
               <rdf:li>Agricultural automation</rdf:li>
            </rdf:Bag>
         </dc:subject>
