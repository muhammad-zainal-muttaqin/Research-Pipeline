#!/bin/sh
# Menegakkan AGENTS.md §1 "Larangan tulisan agen": Markdown baru hanya boleh di jalur ini.
[ "$IZINKAN_MD" = "1" ] && exit 0
baru=$(git diff --cached --name-only --diff-filter=AC -- '*.md' | grep -Ev \
  -e '^literature/entries/[0-9]{3} - ' \
  -e '^literature/scopus-2026-09/entri/' \
  -e '^literature/(extracted|withheld)/' \
  -e '^experiments/SR/SR-[0-9]{3}-' \
  -e '(^|/)README\.md$')
[ -z "$baru" ] && exit 0
echo "Commit ditolak: berkas Markdown baru di luar jalur yang diizinkan (AGENTS.md §1)." >&2
echo "$baru" | sed 's/^/  /' >&2
echo "Tulis penjelasan di percakapan atau pesan commit. Bila pengguna memintanya: IZINKAN_MD=1 git commit ..." >&2
exit 1
