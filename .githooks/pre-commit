#!/bin/sh
# Menegakkan AGENTS.md §1 "Larangan tulisan agen": Markdown baru hanya boleh di jalur tertentu; Python baru dilarang.
gagal=0
if [ "$IZINKAN_MD" != "1" ]; then
  baru=$(git diff --cached --name-only --diff-filter=AC -- '*.md' | grep -Ev \
    -e '^literature/entries/[0-9]{3} - ' \
    -e '^literature/scopus-2026-09/entri/' \
    -e '^literature/(extracted|withheld)/' \
    -e '^experiments/SR/SR-[0-9]{3}-' \
    -e '(^|/)README\.md$')
  if [ -n "$baru" ]; then
    echo "Commit ditolak: berkas Markdown baru di luar jalur yang diizinkan (AGENTS.md §1)." >&2
    echo "$baru" | sed 's/^/  /' >&2
    echo "Tulis penjelasan di percakapan atau pesan commit. Bila pengguna memintanya: IZINKAN_MD=1 git commit ..." >&2
    gagal=1
  fi
fi
if [ "$IZINKAN_PY" != "1" ]; then
  baru=$(git diff --cached --name-only --diff-filter=AC -- '*.py' | grep -Ev \
    -e '^tools/' -e '^experiments/code/' -e '^pipeline/')
  if [ -n "$baru" ]; then
    echo "Commit ditolak: berkas Python baru di luar tools/, experiments/code/, dan pipeline/ (AGENTS.md §1)." >&2
    echo "$baru" | sed 's/^/  /' >&2
    echo "Pemeriksaan sekali pakai dijalankan langsung tanpa disimpan. Bila pengguna memintanya: IZINKAN_PY=1 git commit ..." >&2
    gagal=1
  fi
fi
exit $gagal
